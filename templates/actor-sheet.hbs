<form class="{{cssClass}} sombre-sheet" autocomplete="off">
  <header class="sombre-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" alt="">
    <div class="identity">
      <p class="eyebrow">{{scenarioLabel}}</p>
      <div class="field-with-action name-field">
        <input class="character-name" name="name" type="text" value="{{actor.name}}" placeholder="Nom du personnage">
        {{#if isHouse}}<button type="button" data-random-name {{#unless canRandomizeName}}disabled{{/unless}}
                title="{{#if canRandomizeName}}Proposer un nom texan au hasard{{else}}Tirage du nom verrouillé par le MJ{{/if}}">
          <i class="fa-solid fa-shuffle"></i> Nom
        </button>{{/if}}
        {{#if isHouse}}{{#if isGM}}
          <button type="button" class="random-lock {{#if nameRandomLocked}}active{{/if}}"
                  data-lock-random="name"
                  title="{{#if nameRandomLocked}}Déverrouiller le tirage du nom{{else}}Verrouiller le tirage du nom{{/if}}">
            <i class="fa-solid {{#if nameRandomLocked}}fa-lock{{else}}fa-lock-open{{/if}}"></i>
          </button>
        {{/if}}{{/if}}
      </div>
      <div class="identity-fields">
        <label>
          <span>Joueur</span>
          <input name="system.playerName" type="text" value="{{system.playerName}}" placeholder="Nom du joueur">
        </label>
        <label class="profession-field">
          <span>Profession</span>
          <span class="field-with-action profession-input">
            <input name="system.profession" type="text" value="{{system.profession}}" placeholder="Profession ordinaire">
            {{#if isHouse}}<button type="button" data-random-profession {{#unless canRandomizeProfession}}disabled{{/unless}}
                    title="{{#if canRandomizeProfession}}Proposer une profession au hasard{{else}}Tirage de la profession verrouillé par le MJ{{/if}}">
              <i class="fa-solid fa-shuffle"></i>
            </button>{{/if}}
            {{#if isHouse}}{{#if isGM}}
              <button type="button" class="random-lock {{#if professionRandomLocked}}active{{/if}}"
                      data-lock-random="profession"
                      title="{{#if professionRandomLocked}}Déverrouiller le tirage de la profession{{else}}Verrouiller le tirage de la profession{{/if}}">
                <i class="fa-solid {{#if professionRandomLocked}}fa-lock{{else}}fa-lock-open{{/if}}"></i>
              </button>
            {{/if}}{{/if}}
          </span>
        </label>
      </div>
    </div>
  </header>

  <nav class="sheet-tabs" aria-label="Sections de la fiche">
    <button type="button" class="{{#if mainTabActive}}active{{/if}}" data-sheet-tab="main">
      <i class="fa-solid fa-user"></i> Fiche
    </button>
    <button type="button" class="{{#if detailsTabActive}}active{{/if}}" data-sheet-tab="details">
      <i class="fa-solid fa-address-card"></i> Liens & notes
    </button>
  </nav>

  <div class="sheet-scroll">
    <div class="sheet-tab-content" data-sheet-tab-content="main" {{#unless mainTabActive}}hidden{{/unless}}>
      <section class="sheet-card personality-card">
      <div class="section-heading">
        <div>
          <small>Profil psychologique</small>
          <h2>Personnalité</h2>
        </div>
        <div class="heading-actions">
          <button type="button" data-random-personality {{#unless canRandomizePersonality}}disabled{{/unless}}
                  title="{{#if canRandomizePersonality}}Tirer une Personnalité au hasard{{else}}{{#if personalityRandomLocked}}Tirage verrouillé par le MJ{{else}}Tirage aléatoire déjà utilisé{{/if}}{{/if}}">
            <i class="fa-solid fa-shuffle"></i>
            {{#if canRandomizePersonality}}Hasard{{else}}{{#if personalityRandomLocked}}Verrouillé{{else}}Hasard utilisé{{/if}}{{/if}}
          </button>
          {{#if isGM}}
            <button type="button" class="random-lock {{#if personalityRandomLocked}}active{{/if}}"
                    data-lock-random="personality"
                    title="{{#if personalityRandomLocked}}Déverrouiller le tirage pour les joueurs{{else}}Verrouiller le tirage pour les joueurs{{/if}}">
              <i class="fa-solid {{#if personalityRandomLocked}}fa-lock{{else}}fa-lock-open{{/if}}"></i>
            </button>
          {{/if}}
        </div>
      </div>
      {{#if isGM}}
        <select name="system.personality">
          {{#each personalityChoices}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      {{else}}
        <div class="locked-selection">
          {{#if personalityRevealed}}{{personalityLabel}}{{else}}À tirer au hasard{{/if}}
        </div>
      {{/if}}
      {{#if personalityRevealed}}
        <div class="personality-phases">
          {{#each personalityPhases}}
            <button type="button" class="phase {{#if current}}current viewing{{/if}}"
                    data-personality-help="{{number}}"
                    aria-expanded="{{#if current}}true{{else}}false{{/if}}"
                    title="Afficher le guide de roleplay de cette phase">
              <small>Phase {{number}}</small>
              <strong>{{label}}</strong>
            </button>
          {{/each}}
        </div>
        <div class="personality-guides">
          {{#each personalityPhases}}
            <div class="personality-guide" data-personality-guide="{{number}}" {{#unless current}}hidden{{/unless}}>
              <strong>Phase {{number}} — {{label}}</strong>
              <p>{{description}}</p>
            </div>
          {{/each}}
          <small class="personality-guide-note">
            La phase active dépend de l’Esprit. Cliquer ici ne change pas la jauge.
          </small>
        </div>
      {{/if}}
      </section>

      <section class="sheet-card traits-card">
      <div class="section-heading">
        <div>
          <small>Profil Classic</small>
          <h2>Traits</h2>
        </div>
      </div>
      <div class="traits-grid">
        <div class="trait-column">
          <div class="trait-column-heading">
            <span>Avantage</span>
            <div class="trait-column-actions">
              <button type="button" data-random-trait="advantage" {{#unless canRandomizeAdvantage}}disabled{{/unless}} title="{{advantageRandomTitle}}">
                <i class="fa-solid fa-shuffle"></i> {{advantageRandomStatus}}
              </button>
              {{#if isGM}}
                <button type="button" class="random-lock {{#if advantageRandomLocked}}active{{/if}}" data-lock-random="advantage"
                        title="{{#if advantageRandomLocked}}Déverrouiller le tirage d’Avantage{{else}}Verrouiller le tirage d’Avantage{{/if}}">
                  <i class="fa-solid {{#if advantageRandomLocked}}fa-lock{{else}}fa-lock-open{{/if}}"></i>
                </button>
              {{/if}}
            </div>
          </div>
          {{#if isGM}}
            <select name="system.advantage">
              {{#each advantageChoices}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          {{else}}
            <div class="locked-selection">{{#if system.advantage}}{{system.advantage}}{{else}}À tirer au hasard{{/if}}</div>
          {{/if}}
          {{#if advantageHelp}}<small class="trait-help">{{advantageHelp}}</small>{{/if}}
        </div>
        <div class="trait-column">
          <div class="trait-column-heading">
            <span>Désavantage</span>
            <div class="trait-column-actions">
              <button type="button" data-random-trait="disadvantage" {{#unless canRandomizeDisadvantage}}disabled{{/unless}} title="{{disadvantageRandomTitle}}">
                <i class="fa-solid fa-shuffle"></i> {{disadvantageRandomStatus}}
              </button>
              {{#if isGM}}
                <button type="button" class="random-lock {{#if disadvantageRandomLocked}}active{{/if}}" data-lock-random="disadvantage"
                        title="{{#if disadvantageRandomLocked}}Déverrouiller le tirage de Désavantage{{else}}Verrouiller le tirage de Désavantage{{/if}}">
                  <i class="fa-solid {{#if disadvantageRandomLocked}}fa-lock{{else}}fa-lock-open{{/if}}"></i>
                </button>
              {{/if}}
            </div>
          </div>
          {{#if isGM}}
            <select name="system.disadvantage">
              {{#each disadvantageChoices}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          {{else}}
            <div class="locked-selection">{{#if system.disadvantage}}{{system.disadvantage}}{{else}}À tirer au hasard{{/if}}</div>
          {{/if}}
          {{#if disadvantageHelp}}<small class="trait-help">{{disadvantageHelp}}</small>{{/if}}
        </div>
      </div>
      {{#if isHouse}}<p class="hint">Les Traits incompatibles avec House ne sont pas proposés.</p>{{/if}}
      </section>

      {{#if isGM}}
        <section class="antagonist-config">
          <label>
            <input type="checkbox" data-antagonist-toggle {{checked isAntagonist}}>
            <span><strong>Mode Antagoniste</strong><small>Autorise un Corps supérieur à 12 et désactive l’Adrénaline.</small></span>
          </label>
          {{#if isAntagonist}}
            <label class="antagonist-body-max">
              <span>Corps maximal</span>
              <input type="number" min="12" max="30" step="1" value="{{system.resources.body.max}}" data-antagonist-body-max>
            </label>
          {{/if}}
        </section>
      {{/if}}

      <div class="resource-grid {{#if isAntagonist}}antagonist-resources{{/if}}">
      <section class="resource-card spirit">
        <div class="resource-title">
          <button type="button" data-roll="test" data-ability="spirit"><i class="fa-solid fa-dice-d20"></i> ESPRIT</button>
          <strong>{{system.resources.spirit.value}}</strong>
          <span>{{spiritState}}</span>
        </div>
        <div class="gauge">
          {{#each spiritGauge}}
            <button type="button" class="{{#if active}}active{{/if}} {{#if filled}}filled{{/if}}" data-resource="spirit" data-value="{{level}}" title="Esprit {{level}}">{{level}}</button>
          {{/each}}
        </div>
      </section>

      <section class="resource-card body">
        <div class="resource-title">
          <button type="button" data-roll="test" data-ability="body"><i class="fa-solid fa-dice-d20"></i> CORPS</button>
          <strong>{{system.resources.body.value}}</strong>
          <span>{{bodyState}}</span>
        </div>
        <div class="gauge body-gauge {{#if isAntagonist}}extended{{/if}}">
          {{#each bodyGauge}}
            <button type="button" class="{{#if active}}active{{/if}} {{#if filled}}filled{{/if}}" data-resource="body" data-value="{{level}}" title="Corps {{level}}">{{level}}</button>
          {{/each}}
        </div>
      </section>

      {{#unless isAntagonist}}<section class="resource-card adrenaline">
        <div class="resource-title">
          <span>ADRÉNALINE</span>
          <strong>{{system.resources.adrenaline.value}}</strong>
          <small>Cochée(s) · {{adrenalineUnlocked}}/3 débloqué(s)</small>
        </div>
        {{#if system.adrenalinePending}}
          <p class="resource-help adrenaline-ready"><strong>Adrénaline engagée :</strong> le prochain jet de Corps ou d’attaque se fera sous 12.</p>
        {{/if}}
        <div class="gauge compact">
          {{#each adrenalineGauge}}
            <button type="button"
                    class="{{#if active}}active{{/if}} {{#if filled}}filled{{/if}} {{#if locked}}locked{{/if}}"
                    data-resource="adrenaline"
                    data-value="{{level}}"
                    title="{{title}}"
                    {{#if disabled}}disabled{{/if}}>{{level}}</button>
          {{/each}}
        </div>
      </section>{{/unless}}
      </div>

      <section class="dice-strip">
        <span>Jets rapides</span>
        <button type="button" data-roll="attack" data-ability="body"><i class="fa-solid fa-burst"></i> Attaque (d20 + d6)</button>
        <button type="button" data-roll="damage"><i class="fa-solid fa-dice-six"></i> d6</button>
      </section>
    </div>

    <div class="sheet-tab-content details-layout" data-sheet-tab-content="details" {{#unless detailsTabActive}}hidden{{/unless}}>
      <section class="sheet-card">
        <div class="section-heading">
          <div>
          <small>{{#if isHouse}}Famille et amitiés{{else}}Relations et passé{{/if}}</small>
            <h2>Liens</h2>
          </div>
        </div>
        <label class="details-field">
          <span>Lien positif — personne et raison</span>
          <textarea name="system.positiveLink" rows="9" placeholder="Avec quel autre survivant, et pourquoi ?">{{system.positiveLink}}</textarea>
        </label>
        <label class="details-field">
          <span>Background court</span>
          <textarea name="system.background" rows="5" placeholder="Passé, relations, détails du personnage…">{{system.background}}</textarea>
        </label>
      </section>

      <section class="sheet-card">
        <div class="section-heading">
          <div>
            <small>Survie</small>
            <h2>{{#if isHouse}}Carte & équipement{{else}}Équipement{{/if}}</h2>
          </div>
        </div>
        {{#if isHouse}}<label class="details-field special-card-field">
          <span>Carte spéciale</span>
          <select name="system.specialCard">
            {{#each specialCardChoices}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </label>{{/if}}
        <label class="details-field">
          <span>Équipement et notes</span>
          <textarea name="system.equipment" rows="7" placeholder="Objets, munitions, blessures décrites…">{{system.equipment}}</textarea>
        </label>
      </section>

      {{#if canViewSecret}}{{#if hasSecret}}
        <section class="sheet-card scenario-secret-card {{#if system.specialUsed}}used{{/if}}">
          <div class="section-heading">
            <div>
              <small>Information personnelle</small>
              <h2>{{#if isSpecialAbility}}Capacité spéciale{{else}}Secret{{/if}}</h2>
            </div>
            <button type="button" data-reveal-secret><i class="fa-solid fa-comment"></i> Révéler au chat</button>
          </div>
          <p>{{system.secret}}</p>
          {{#if isSpecialAbility}}
            <button type="button" class="special-use" data-use-special>
              <i class="fa-solid {{#if system.specialUsed}}fa-square-check{{else}}fa-square{{/if}}"></i>
              {{#if system.specialUsed}}Capacité utilisée{{else}}Capacité disponible{{/if}}
            </button>
          {{/if}}
        </section>
      {{/if}}{{/if}}

      {{#if isGM}}
        <section class="sheet-card scenario-gm-card">
          <div class="section-heading"><div><small>MJ uniquement</small><h2>Suivi du scénario</h2></div></div>
          <label class="scenario-infected"><input name="system.infected" type="checkbox" {{checked system.infected}}> Infecté</label>
          <textarea name="system.gmNotes" rows="5" placeholder="Notes de maîtrise…">{{system.gmNotes}}</textarea>
        </section>
      {{/if}}
    </div>
  </div>
</form>
